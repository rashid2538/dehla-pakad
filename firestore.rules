rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /friendRequests/{reqId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
      }

      match /gameInvites/{inviteId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
      }
    }

    // Games
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      // Private hands — owner can read; host can read bot hands; any authed user can write/delete
      match /privateHands/{handUid} {
        allow read: if request.auth != null && (
          request.auth.uid == handUid ||
          (handUid.matches('bot_.*') &&
           get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid)
        );
        allow write: if request.auth != null;
      }
    }
  }
}
